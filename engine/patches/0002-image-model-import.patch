+// createImageGenModel imports a diffusers image pipeline (model_index.json plus component folders).
+func createImageGenModel(opts CreateOptions, p *progress.Progress) error {
+	spinner := progress.NewSpinner("importing image generation model")
+	p.Add("imagegen", spinner)
+	progressFn := func(msg string) {
+		spinner.Stop()
+		spinner = progress.NewSpinner(msg)
+		p.Add("imagegen", spinner)
+	}
+
+	err := create.CreateImageGenModel(
+		opts.ModelName, opts.ModelDir, opts.Quantize,
+		create.StoreFromLayerCreator(newLayerCreator()),
+		newManifestWriter(opts, []string{"image"}, "", ""),
+		progressFn,
+	)
+	spinner.Stop()
+	if err != nil {
+		return err
+	}
+
+	fmt.Printf("Created image generation model '%s'\n", opts.ModelName)
+	return nil
+}
